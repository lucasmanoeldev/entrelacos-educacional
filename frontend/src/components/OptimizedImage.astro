---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; widths?: number[]; sizes?: string; eager?: boolean; }
const { src, alt, widths = [320, 640, 960], sizes = '(max-width: 640px) 100vw, 640px', eager = false } = Astro.props;
---
<Image src={src} alt={alt} format="webp" widths={widths.filter(w => w <= src.width)} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'}/>
