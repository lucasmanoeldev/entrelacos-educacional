---
import Base from './Base.astro';
import Brand from '../components/Brand.astro';
const links = [['/dashboard/', 'Visão geral', '▦'], ['/dashboard/atividades/', 'Minhas atividades', '▤'], ['/explorar/', 'Explorar biblioteca', '◇'], ['/dashboard/favoritos/', 'Favoritos', '♡'], ['/dashboard/resultados/', 'Resultados', '▥'], ['/dashboard/ia/', 'Criar com IA', '✦'], ['/dashboard/configuracoes/', 'Minha conta', '⚙']];
---
<Base><div class="dashboard" data-protected><aside class="sidebar" transition:persist="dashboard-menu"><div class="sidebar-brand"><Brand/><button class="icon-button mobile-only" aria-label="Fechar menu" data-menu-close>×</button></div><a href="/dashboard/atividades/criar/" class="button full" data-teacher><span aria-hidden="true">＋</span> Criar atividade</a><span class="nav-label">SEU ESPAÇO</span><nav>{links.map(([href,label,icon])=><a href={href}><span aria-hidden="true">{icon}</span>{label}</a>)}</nav><div class="sidebar-bottom"><div class="sidebar-note"><span>✳</span><b>Uma ideia pode<br/>mudar uma aula.</b><p>Que tal experimentar um novo formato hoje?</p></div><button class="logout" data-logout>Sair da conta</button></div></aside><div class="dashboard-body"><header class="dashboard-header" transition:persist="dashboard-header"><div><button class="icon-button mobile-only" aria-label="Abrir menu" data-menu-open>☰</button><span>Seu espaço de descobertas</span></div><div><a href="/jogar/">Entrar com código ↗</a><span class="avatar" data-avatar></span><span class="user-label" data-user-name></span></div></header><main class="dashboard-main" id="content"><div data-shell-error role="alert"></div><slot/></main></div></div></Base>
